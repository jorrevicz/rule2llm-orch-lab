# Copie para .env e ajuste localmente. O .env não é versionado.
# Parâmetros experimentais NÃO ficam aqui: a fonte de verdade é config/experiment_config.yml.

# Credenciais do RabbitMQ (ambiente local do experimento)
RABBITMQ_DEFAULT_USER=tcc
