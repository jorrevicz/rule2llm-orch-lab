# Copie para .env e ajuste localmente. O .env não é versionado.
# Parâmetros experimentais NÃO ficam aqui: a fonte de verdade é config/experiment_config.yml.

# Broker (usuário tcc/tcc declarado em config/rabbitmq/definitions.json — ambiente local)
BROKER_URL=amqp://tcc:tcc@rabbitmq:5672//

# Caminho do arquivo de configuração experimental
EXPERIMENT_CONFIG_PATH=config/experiment_config.yml
